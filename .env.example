# DeepSeek runtime (leave the key empty for offline tests)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional semantic RAG. Disabled means no Chroma/model import or I/O.
TEACHER_RAG_ENABLED=false
CHROMA_SERVER=localhost:8002
TEACHER_RAG_VECTORDB_PATH=
TEACHER_RAG_EMBED_MODEL=BAAI/bge-m3
TEACHER_RAG_REFERENCE_COLLECTIONS=k9_textbook,curriculum_std
TEACHER_RAG_EXERCISE_COLLECTIONS=k9_exercises
TEACHER_RAG_TOPK=5
TEACHER_RAG_MIN_SIMILARITY=0.44
TEACHER_RAG_SUBJECT_FILTER=数学
TEACHER_RAG_DEVICE=cpu
TEACHER_RAG_CPU_THREADS=4
