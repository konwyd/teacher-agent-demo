# Teacher model (the one-command local launcher overrides these DeepSeek values)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=300
# Hosted endpoints may still expose a real 128K limit. The local launcher overrides
# this with the exact --ctx-size passed to llama-server (524288 / 512K by default).
DEEPSEEK_CONTEXT_WINDOW_TOKENS=131072

# Local demo accounts (SQLite; passwords are stored as salted hashes)
TEACHER_ACCOUNT_DB=data/runtime/users.sqlite3
TEACHER_CONVERSATION_DB=data/runtime/conversations.sqlite3

# llama-server KV slot persistence (the one-command launcher enables these automatically)
TEACHER_KV_PERSIST=0
TEACHER_KV_CACHE_DIR=data/runtime/kv-states
# Leave empty to derive the same host and port from DEEPSEEK_BASE_URL.
TEACHER_KV_SERVER_URL=
TEACHER_LLAMA_PARALLEL=1
TEACHER_KV_HTTP_TIMEOUT_SECONDS=30
TEACHER_KV_KEEP_VERSIONS=2

TAVILY_API_KEY=
