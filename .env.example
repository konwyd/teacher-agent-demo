# Teacher model backend switch. Configure both profiles once, then change only
# TEACHER_LLM_BACKEND between local and api. Leave it empty to preserve the
# legacy DEEPSEEK_* behavior below.
TEACHER_LLM_BACKEND=

# Local llama.cpp profile
TEACHER_LOCAL_LLM_API_KEY=local
TEACHER_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
TEACHER_LOCAL_LLM_MODEL=deepseek-v4-flash
TEACHER_LOCAL_LLM_CONTEXT_WINDOW_TOKENS=524288

# Hosted API profile (put the real key only in .env; never commit it)
TEACHER_API_LLM_API_KEY=
TEACHER_API_LLM_BASE_URL=https://api.deepseek.com
TEACHER_API_LLM_MODEL=deepseek-chat
TEACHER_API_LLM_CONTEXT_WINDOW_TOKENS=131072

# Legacy configuration (used only when TEACHER_LLM_BACKEND is empty)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=300
# Hosted endpoints may still expose a real 128K limit. The local launcher overrides
# this with the exact --ctx-size passed to llama-server (524288 / 512K by default).
DEEPSEEK_CONTEXT_WINDOW_TOKENS=131072

# Local demo accounts (SQLite; passwords are stored as salted hashes)
TEACHER_ACCOUNT_DB=data/runtime/users.sqlite3
TEACHER_CONVERSATION_DB=data/runtime/conversations.sqlite3

# Defaults to TEACHER_CONVERSATION_DB when empty; set a separate path if desired.
TEACHER_STUDENT_MEMORY_DB=

# llama-server KV slot persistence (the one-command launcher enables these automatically)
TEACHER_KV_PERSIST=0
TEACHER_KV_CACHE_DIR=data/runtime/kv-states
# Leave empty to derive the same host and port from DEEPSEEK_BASE_URL.
TEACHER_KV_SERVER_URL=
TEACHER_LLAMA_PARALLEL=4
TEACHER_LLAMA_UNIFIED_KV=1
TEACHER_MAX_CONCURRENT_GENERATIONS=4
TEACHER_KV_HTTP_TIMEOUT_SECONDS=30
# Keep one validated snapshot per conversation; cleanup starts at 80 GiB and stops at 70 GiB.
TEACHER_KV_KEEP_VERSIONS=1
TEACHER_KV_CACHE_BUDGET_GIB=100
TEACHER_KV_CACHE_HIGH_WATER_GIB=80
TEACHER_KV_CACHE_LOW_WATER_GIB=70
TEACHER_KV_MODEL_ID=deepseek-v4-flash
TEACHER_KV_CACHE_FORMAT=llama-server-slot-v2-dsv4-unified
TEACHER_KV_CONTEXT_TOKENS=524288
TEACHER_KV_CACHE_TYPE_K=q8_0
TEACHER_KV_CACHE_TYPE_V=q4_0

# Infinite-conversation working context. Full dialogue remains in SQLite; when
# the model prompt approaches the native window, old turns become a rolling
# semantic summary while recent turns remain verbatim.
TEACHER_CONTEXT_COMPACTION_ENABLED=1
TEACHER_CONTEXT_COMPACTION_TRIGGER_RATIO=0.80
TEACHER_CONTEXT_COMPACTION_TARGET_RATIO=0.55
TEACHER_CONTEXT_COMPACTION_MIN_RECENT_TURNS=12
TEACHER_CONTEXT_OUTPUT_RESERVE_TOKENS=8192
TEACHER_CONTEXT_SUMMARY_MAX_TOKENS=4096

TAVILY_API_KEY=

# Curated historical Q&A reference library. It is a separate Chroma collection
# from textbook/exercise RAG. Historical answers are reference-only and never
# returned directly. The online router decides independently whether to query it.
TEACHER_QUALITY_QA_ENABLE=0
TEACHER_QUALITY_QA_NIGHTLY=0
TEACHER_QUALITY_QA_COLLECTION=quality_qa
TEACHER_QUALITY_QA_THRESHOLD=0.78
TEACHER_QUALITY_QA_DUPLICATE_THRESHOLD=0.94
TEACHER_QUALITY_QA_TOPK=3
TEACHER_QUALITY_QA_MIN_SCORE=0.85
TEACHER_QUALITY_QA_STATE_DB=data/runtime/quality_qa_state.sqlite3
TEACHER_QUALITY_QA_LOCK_FILE=data/runtime/quality_qa_pipeline.lock
TEACHER_QUALITY_QA_CACHE_TTL_SECONDS=3600
TEACHER_QUALITY_QA_CACHE_MAX_ENTRIES=2048
TEACHER_QUALITY_QA_MAX_INPUT_CHARS=28000

# Memory v2 Phase 1.5 contract foundation. All flags default off. The two
# ENABLED flags are parsed but remain non-authoritative until a later phase.
TEACHER_MEMORY_ADMISSION_ENABLED=0
TEACHER_MEMORY_ADMISSION_SHADOW_MODE=0
TEACHER_MEMORY_CONTROLLER_ENABLED=0
TEACHER_MEMORY_CONTROLLER_SHADOW_MODE=0
# Phase 2A shadow-only evidence and optional bounded human-review export.
# Enabling shadow mode does not grant authority over baseline memory writes.
TEACHER_MEMORY_ADMISSION_LEDGER_DB=data/runtime/memory_admission_shadow.sqlite3
TEACHER_MEMORY_ADMISSION_REVIEW_EXPORT=
TEACHER_MEMORY_ADMISSION_REVIEW_MAX_RECORDS=100
